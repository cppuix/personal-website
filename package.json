{
  "name": "my-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:quality && astro build",
    "preview": "astro preview",
    "import-blog": "node import-blog.js",
    "check:types": "astro check",
    "check:taxonomy": "node scripts/check-taxonomy.mjs",
