  },
  "dependencies": {
    "@astrojs/vercel": "^10.0.6",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "astro": "^6.2.1",
    "cookie": "^1.1.1",
    "xml2js": "^0.6.2"
  }
