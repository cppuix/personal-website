{
  "redirects": [
    { "source": "/creed/lesson:slug/:path*", "destination": "/works/creed/lesson:slug", "permanent": true },
    { "source": "/creed/creedqa1/:path*", "destination": "/works/creed/lesson1", "permanent": true },
    { "source": "/creed/creedqa2/:path*", "destination": "/works/creed/lesson2", "permanent": true },
    { "source": "/creed/creedqa3/:path*", "destination": "/works/creed/lesson3", "permanent": true },
    { "source": "/creed/creedqa4/:path*", "destination": "/works/creed/lesson4", "permanent": true },
    { "source": "/creed/creedqa5/:path*", "destination": "/works/creed/lesson5", "permanent": true },
    { "source": "/creed/creedqa6/:path*", "destination": "/works/creed/lesson5", "permanent": true },
    { "source": "/creed/creedqa7/:path*", "destination": "/works/creed/lesson5", "permanent": true }
  ],
  "rewrites": [
    { "source": "/config.yml", "destination": "/admin/config.yml" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
