---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import ShareControls from '../../components/ShareControls.astro';
import { translations } from '../../i18n/translations.js';

export async function getStaticPaths() {
  const posts: CollectionEntry<'blog'>[] = await getCollection("blog");
  return posts.map((post) => {
    const slug = post.id.split("/").pop();
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const allPosts: CollectionEntry<'blog'>[] = await getCollection("blog");
const post = allPosts.find(
  (p) => p.id.split("/").pop() === slug
);

if (!post) return Astro.redirect("/blog");

const { Content } = await render(post);
const publishedTime = post.data.date?.toISOString();
const canonicalUrl = `/blog/${slug}`;
const ogImage = post.data.coverImage || '/og/default.svg';
---

<Base
  title={post.data.title}
  description={post.data.description}
  canonical={canonicalUrl}
  image={ogImage}
  ogType="article"
  articlePublishedTime={publishedTime}
  articleModifiedTime={publishedTime}
  articleTags={post.data.tags ?? []}
  articleAuthor={post.data.author}
>
  <Nav />

  <main style="position:relative; z-index:1;">
    <article class="blog-post container" style="max-width: 800px; margin: 0 auto; padding: 4rem 1rem 6rem;">
      <!-- Article header -->
      <header class="blog-post__header">
        <div class="book-card__tags" style="margin-bottom:1rem;">
          {post.data.category && (
            <span class="book-tag book-tag--cat" data-i18n={`blog.category.${post.data.category}`}>
              {post.data.category}
            </span>
          )}
          {post.data.tags?.map((tag: string) => (
            <span class="book-tag book-tag--cat" data-tag={tag} data-tag-original={tag}>{tag}</span>
          ))}
        </div>
        <h1 class="lib-hero__title" style="text-align:left; font-size:2.2rem; margin-bottom:0.75rem;">
          {post.data.title}
        </h1>
        <time datetime={post.data.date.toISOString()} style="color:var(--text-muted); font-family:var(--font-ui); font-size:0.9rem;">
          {post.data.date.toLocaleDateString("en", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      </header>

      <!-- Rendered content -->
      <div class="blog-content" style="margin-top:2rem; line-height:1.8;">
        <Content />
      </div>

      <div class="article-share" style="margin-top:2.5rem;">
        <ShareControls url={canonicalUrl} title={post.data.title} description={post.data.description} variant="compact" />
      </div>
    </article>
  </main>

  <script define:vars={{ translations }}>
    function normalizeTagKey(value) {
      return (value || '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\u0600-\u06ff]+/g, '_')
        .replace(/^_+|_+$/g, '');
    }

    function applyI18n(lang) {
      const tr = translations[lang] || translations['en'];
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const keys = el.getAttribute('data-i18n').split('.');
        let val = tr;
        for (const k of keys) val = val?.[k];
        if (!val || typeof val !== 'string') return;
        el.textContent = val;
      });

      document.querySelectorAll('[data-tag]').forEach(el => {
        const original = el.getAttribute('data-tag-original') || el.getAttribute('data-tag') || '';
        const key = normalizeTagKey(original);
        const localized = tr.blog?.tags?.[key];
        el.textContent = localized || original;
      });
    }

    applyI18n(window.__settings?.lang || 'en');
    window.addEventListener('lang-change', () => applyI18n(window.__settings?.lang || 'en'));
  </script>
</Base>
