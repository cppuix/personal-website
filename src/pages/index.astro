---
import { getCollection } from "astro:content";
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import BookCard from '../components/BookCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { translations } from '../i18n/translations.js';

const blogPosts = await getCollection("blog");
const recentPostsEn = blogPosts
  .filter((post) => post.id.startsWith("en/"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const recentPostsAr = blogPosts
  .filter((post) => post.id.startsWith("ar/"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allBooks = await getCollection("books");
const featuredBooks = allBooks
  .filter(book => book.data.featured)
  .slice(0, 4);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured)
  .slice(0, 3)
  .map(project => ({
    ...project.data,
    cover: project.data.coverImage,
    detailUrl: `/projects/${project.id}`,
  }));
---

<Base
    title="عبد الرحمن بن ميهوب القداري"
    description="A place for books, writings, translations, and tools."
    canonical="https://alqaddari.vercel.app"
    image="/og/default.svg"
    ogType="website"
  >
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__content">
        <p class="hero__name-arabic" data-i18n="hero.greeting">عَبْدُ الرَّحْمَنِ بْنُ مِيهُوبَ القَدَّارِيُّ</p>
        <h1 class="hero__title">
          <!-- Use .en/.ar so dir-attribute CSS handles switching — preserves <em> -->
          <span class="en">A <em>Knowledge</em> Seeker</span>
          <span class="ar">طالب علم</span>
        </h1>
        <p class="hero__desc" data-i18n="hero.desc">
          A place for books, writings, and tools — gathered here so they are not lost.
        </p>
        <a href="/library" class="hero__cta">
          <span data-i18n="hero.cta">Explore the library →</span>
        </a>
      </div>

      <div class="hero__watermark" aria-hidden="true">ب</div>
    </div>
  </section>

  <div class="divider" aria-hidden="true">· · ·</div>

  <!-- RECENT BLOG POSTS -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="section__label" data-i18n="sections.blogLabel">Essays & Notes</p>
          <h2 class="section__title" data-i18n="sections.landingLatestWritings">Latest Writings</h2>
        </div>
        <a href="/blog" data-i18n="sections.blogBrowse">See all posts →</a>
      </div>
      <div class="book-grid">
        {[...recentPostsEn, ...recentPostsAr].map((post) => {
          const slug = post.id.split("/").pop();
          const postLang = post.id.split("/")[0];
          const rawDate = post.data.date.toISOString();
          const defaultDate = post.data.date.toLocaleDateString("en", {
            year: "numeric",
            month: "long",
            day: "numeric",
          });
          return (
            <a href={`/blog/${slug}`} class="book-card home-post" data-blog-lang={postLang} style="text-decoration:none; color:inherit;">
              <div class="book-card__tags">
                {post.data.tags?.slice(0, 2).map(tag => (
                  <span class="book-tag book-tag--cat">{tag}</span>
                ))}
              </div>
              <h3 class="book-card__title">{post.data.title}</h3>
              <p class="book-card__author" data-date={rawDate}>{defaultDate}</p>
              <div class="book-card__footer">
                <span class="book-card__open" data-i18n="common.read">Read →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true">· · ·</div>

  <!-- FEATURED BOOKS -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="section__label" data-i18n="sections.libraryLabel">Books & PDFs</p>
          <h2 class="section__title" data-i18n="sections.landingFeaturedBooks">Featured Books</h2>
        </div>
        <a href="/library" data-i18n="sections.landingSeeAllBooks">See all books →</a>
      </div>
      <div class="book-grid">
        {featuredBooks.map((book) => {
          const link = `/library?book=${encodeURIComponent(book.id)}`;
          return (
            <a href={link} class="book-card-link home-book-link" data-book-lang={book.data.language} style="text-decoration:none;color:inherit;">
              <BookCard book={{ id: book.id, ...book.data }} />
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true">· · ·</div>

  <!-- FEATURED PROJECTS -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <h2 class="section__title" data-i18n="sections.landingFeaturedProjects">Featured Digital Projects</h2>
        </div>
        <a href="/apps" data-i18n="sections.landingSeeAllProjects">See all projects →</a>
      </div>
      <div class="card-grid">
        {featuredProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <p data-i18n="footer.text">May Allah make it beneficial.</p>
    </div>
  </footer>

  <script define:vars={{ translations }}>
    function applyI18n(lang) {
      const tr = translations[lang] || translations['en'];
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const keys = el.getAttribute('data-i18n').split('.');
        let val = tr;
        for (const k of keys) val = val?.[k];
        if (val && typeof val === 'string') el.textContent = val;
      });
    }

    function formatHomeDates(lang) {
      document.querySelectorAll('.home-post .book-card__author[data-date]').forEach(el => {
        const raw = el.dataset.date;
        if (!raw) return;
        const date = new Date(raw);
        const formatted = new Intl.DateTimeFormat(lang, {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        }).format(date);
        el.textContent = formatted;
      });
    }

    function filterHomeContent(lang) {
      const postCards = document.querySelectorAll('.home-post');
      postCards.forEach(card => {
        const cardLang = card.dataset.blogLang || 'en';
        const show = cardLang === lang;
        card.style.display = show ? '' : 'none';
      });

      const bookLinks = document.querySelectorAll('.home-book-link');
      bookLinks.forEach(link => {
        const bookLang = link.dataset.bookLang || 'en';
        // 'mixed' books are relevant to all readers
        const show = bookLang === lang || bookLang === 'mixed';
        link.style.display = show ? '' : 'none';
      });
    }

    function applyHomeSettings(lang) {
      applyI18n(lang);
      formatHomeDates(lang);
      filterHomeContent(lang);
    }

    applyHomeSettings(window.__settings?.lang || 'en');
    window.addEventListener('lang-change', () => applyHomeSettings(window.__settings?.lang || 'en'));
  </script>
</Base>