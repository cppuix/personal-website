---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import ShareControls from '../../components/ShareControls.astro';
import { translations } from '../../i18n/translations.js';

export async function getStaticPaths() {
  const projects = /** @type {{ id: string }[]} */ (await getCollection('projects'));
  const paths = [];

  for (const project of projects) {
    paths.push({ params: { slug: project.id } });
  }

  return paths;
}

const { slug } = Astro.params;
const project = await getEntry('projects', slug);
if (!project) {
  throw new Error(`Project not found: ${slug}`);
}
const canonicalUrl = `/projects/${slug}`;
const ogImage = project.data.coverImage || '/og/default.svg';
const tags = /** @type {string[]} */ (Array.isArray(project.data.tags) ? project.data.tags : []);
---
<Base
  title={`${project.data.title} — Digital Project`}
  description={project.data.description}
  canonical={canonicalUrl}
  image={ogImage}
  ogType="website"
>
  <Nav />
  <main style="padding: 4rem 0 6rem;">
    <div class="container">
      <section class="project-detail">
        {project.data.coverImage && (
          <img
            src={project.data.coverImage}
            alt={`Cover for ${project.data.title}`}
            class="project-detail__cover"
            loading="lazy"
          />
        )}

        <div class="project-detail__header">
          <div class="project-detail__tags">
            {project.data.featured && <span class="card__tag card__tag--featured" data-i18n="projectDetail.featured">Featured</span>}
            <span class="card__tag" data-i18n={`projectType.${project.data.type.toLowerCase()}`}>{project.data.type}</span>
            {project.data.category && <span class="card__tag" data-i18n={`projectCategory.${project.data.category}`}>{project.data.category}</span>}
            {tags.map((tag: string) => (
              <span class="card__tag" data-i18n={`projectTag.${tag}`}>{tag}</span>
            ))}
          </div>
          <h1 class="project-detail__title">
            <span class="en">{project.data.title}</span>
            <span class="ar">{project.data.titleAr || project.data.title}</span>
          </h1>
          <p class="project-detail__desc">
            <span class="en">{project.data.description}</span>
            <span class="ar">{project.data.descriptionAr || project.data.description}</span>
          </p>
          {(project.data.note || project.data.noteAr) && (
            <p class="project-detail__note">
              <span class="en">{project.data.note}</span>
              <span class="ar">{project.data.noteAr || project.data.note}</span>
            </p>
          )}
          <div class="project-detail__actions">
            <a class="btn" href={project.data.href} target="_blank" rel="noopener noreferrer" data-i18n="projectDetail.visitSite">Visit site</a>
          </div>
        </div>
      </section>

      <section class="project-share">
        <ShareControls url={canonicalUrl} title={project.data.title} description={project.data.description} variant="compact" />
      </section>
    </div>
  </main>


  <script define:vars={{ translations }}>
    function applyI18n(lang) {
      const tr = translations[lang] || translations['en'];
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const keys = el.getAttribute('data-i18n').split('.');
        let val = tr;
        for (const k of keys) val = val?.[k];
        if (!val || typeof val !== 'string') return;
        el.textContent = val;
      });
    }
    applyI18n(window.__settings?.lang || 'en');
    window.addEventListener('lang-change', () => applyI18n(window.__settings?.lang || 'en'));
  </script>
</Base>
