---
import Base from '../layouts/Base.astro';
import Nav  from '../components/Nav.astro';
import BookCard from '../components/BookCard.astro';
import { translations } from '../i18n/translations.js';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const rawBooks = await getCollection('books');
type LibraryBook = CollectionEntry<'books'>['data'] & { id: string };
const books: LibraryBook[] = rawBooks.map((b: CollectionEntry<'books'>) => ({ id: b.id, ...b.data }));
const CATEGORIES = ['aqeedah','fiqh','hadith','tafsir','seerah','manhaj','fitan','translations','other'];
---
<Base title="Library — عبد الرحمن القدّاري" description="A library of Islamic PDFs — searchable, readable, downloadable.">
  <Nav />

  <main style="position:relative; z-index:1;">

    <div class="lib-hero">
      <div class="container">
        <p class="lib-hero__label" data-i18n="sections.libraryLabel">Books & PDFs</p>
        <h1 class="lib-hero__title" data-i18n="sections.library">Library</h1>
        <p class="lib-hero__sub" id="results-count"></p>
      </div>
    </div>

    <!-- SEARCH & FILTERS -->
<div class="lib-filters-bar" id="filters-bar">
  <div class="container">
    <div class="search-bar" id="search-bar">
      <span class="search-bar__icon">⌕</span>
      <input type="text" id="search-input" data-i18n="library.searchPlaceholder" placeholder="Search titles, authors..." autocomplete="off" spellcheck="false" />
      <button id="search-clear" type="button" class="search-bar__clear" aria-label="Clear search">×</button>
      <button type="button" id="filters-toggle" class="filters-toggle-icon" aria-label="Toggle filters">☰</button>
    </div>

    <div class="filters-panel" id="filters-panel">
      <div class="filters-main" id="cat-filters">
        <button class="filter-chip all active" data-cat="all" data-i18n="library.filterAll">All</button>
        {CATEGORIES.map(cat => (
          <button class="filter-chip" data-cat={cat} data-i18n={`library.category.${cat}`}>{cat.charAt(0).toUpperCase() + cat.slice(1)}</button>
        ))}
      </div>

      <div class="filters-advanced" id="adv-panel" style="display:grid;">
        <div>
          <p class="filter-group__label" data-i18n="library.language">Language</p>
          <div class="filter-group__options" id="lang-filters">
            <button class="filter-chip" data-lang="ar" data-i18n="library.filterArabic">Arabic</button>
            <button class="filter-chip" data-lang="en" data-i18n="library.filterEnglish">English</button>
          </div>
        </div>
        <div>
          <p class="filter-group__label" data-i18n="library.sortBy">Sort by</p>
          <div class="filter-group__options" id="sort-filters">
            <button class="filter-chip active" data-sort="title" data-i18n="library.sortTitle">Title</button>
            <button class="filter-chip" data-sort="author" data-i18n="library.sortAuthor">Author</button>
            <button class="filter-chip" data-sort="category" data-i18n="library.sortCategory">Category</button>
          </div>
        </div>
        <div>
          <p class="filter-group__label" data-i18n="library.showOnly">Show only</p>
          <div class="filter-group__options">
            <button class="filter-chip" id="featured-filter" data-featured="false" data-i18n="library.featuredOnly">Featured</button>
          </div>
        </div>
      </div>

      <p class="filter-results-count" id="results-count-bar"></p>
    </div>
  </div>
</div>

    <!-- BOOK GRID -->
    <div style="padding: 1rem 0 7rem;">
      <div class="container">
        <div class="book-grid" id="book-grid">
          {books.map((book) => (
            <BookCard book={book} />
          ))}
          <div class="book-grid__empty" id="empty-state" style="display:none" data-i18n="library.emptyState">
            No results found
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- READER MODAL -->
  <div class="reader-overlay" id="reader-overlay" role="dialog" aria-modal="true" aria-label="Book reader">
    <div class="reader-panel">

      <div class="reader-header">
        <div class="reader-header__info">
          <p class="reader-header__title" id="reader-title">—</p>
          <p class="reader-header__author" id="reader-author">—</p>
        </div>
        <div class="reader-header__actions">
          <button class="reader-btn--close" id="reader-close" aria-label="Close reader">✕</button>
        </div>
      </div>

      <div class="reader-body" id="reader-body">
        <div class="reader-loading" id="reader-loading">
          <div class="reader-loading__spinner"></div>
          <span id="reader-loading-text" data-i18n="library.readerLoading" style="font-family:var(--font-ui);font-size:0.8rem;color:var(--text-muted);">Loading PDF…</span>
        </div>
        <div class="reader-error" id="reader-error" hidden>
          <p id="reader-error-text"></p>
        </div>
        <!-- Full PDF.js viewer -->
        <iframe
          id="reader-iframe"
          title="PDF Reader"
          style="width:100%;height:100%;border:none;display:none;"
        ></iframe>
      </div>
      <div class="reader-footer">
        <div class="reader-footer__meta">
          <span class="reader-footer__tag reader-footer__tag--cat" id="reader-cat-tag">—</span>
          <span class="reader-footer__tag" id="reader-lang-tag">—</span>
          <span class="reader-footer__tag" id="reader-size-tag" style="opacity:0.6;">—</span>
        </div>
        <div class="reader-footer__actions">
          <a class="reader-btn reader-btn--small" id="reader-archive-link" href="#" target="_blank" rel="noopener noreferrer">Source</a>
          <a class="reader-btn reader-btn--primary reader-btn--small" id="reader-download-link" href="#" target="_blank" rel="noopener noreferrer" data-i18n="library.readerDownload">↓ Download</a>
          <div class="settings-menu-wrapper">
            <button class="reader-btn reader-btn--small settings-menu-toggle" id="reader-share-toggle" type="button" aria-haspopup="menu" aria-expanded="false" data-i18n="shareBar.label">Share</button>
            <div class="settings-menu reader-share-popup" id="reader-share-popup" role="menu" aria-hidden="true">
              <div class="reader-share-popup__buttons">
                <a class="share-bar__button" id="reader-share-telegram" href="#" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 240 240" aria-hidden="true" focusable="false">
                    <defs>
                      <linearGradient id="reader-telegram-gradient" x1="120" y1="240" x2="120" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stop-color="#1d93d2"/>
                        <stop offset="1" stop-color="#38b0e3"/>
                      </linearGradient>
                    </defs>
                    <circle cx="120" cy="120" r="120" fill="url(#reader-telegram-gradient)"/>
                    <path d="M81.229 128.772l14.237 39.406s1.78 3.687 3.686 3.687 30.255-29.492 30.255-29.492l31.525-60.89L81.737 118.6Z" fill="#c8daea"/>
                    <path d="M100.106 138.878l-2.733 29.046s-1.144 8.9 7.754 0 17.415-15.763 17.415-15.763" fill="#a9c6d8"/>
                    <path d="M81.486 130.178 52.2 120.636s-3.5-1.42-2.373-4.64c.232-.664.7-1.229 2.1-2.2 6.489-4.523 120.106-45.36 120.106-45.36s3.208-1.081,5.1-.362a2.766,2.766,0,0,1,1.885,2.055,9.357,9.357,0,0,1,.254,2.585c-.009.752-.1,1.449-.169,2.542-.692,11.165-21.4,94.493-21.4,94.493s-1.239,4.876-5.678,5.043A8.13,8.13,0,0,1,146.1,172.5c-8.711-7.493-38.819-27.727-45.472-32.177a1.27,1.27,0,0,1-.546-.9c-.093-.469.417-1.05.417-1.05s52.426-46.6,53.821-51.492c.108-.379-.3-.566-.848-.4-3.482,1.281-63.844,39.4-70.506,43.607A3.21,3.21,0,0,1,81.486,130.178Z" fill="#fff"/>
                  </svg>
                  <span data-i18n="shareBar.telegram">Telegram</span>
                </a>
                <a class="share-bar__button" id="reader-share-whatsapp" href="#" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 175.216 175.552" aria-hidden="true" focusable="false">
                    <defs>
                      <linearGradient id="reader-whatsapp-gradient" x1="85.915" x2="86.535" y1="32.567" y2="137.092" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stop-color="#57d163"/>
                        <stop offset="1" stop-color="#23b33a"/>
                      </linearGradient>
                      <filter id="reader-whatsapp-blur" width="1.115" height="1.114" x="-.057" y="-.057" color-interpolation-filters="sRGB">
                        <feGaussianBlur stdDeviation="3.531"/>
                      </filter>
                    </defs>
                    <path fill="#b3b3b3" d="m54.532 138.45 2.235 1.324c9.387 5.571 20.15 8.518 31.126 8.523h.023c33.707 0 61.139-27.426 61.153-61.135.006-16.335-6.349-31.696-17.895-43.251A60.75 60.75 0 0 0 87.94 25.983c-33.733 0-61.166 27.423-61.178 61.13a60.98 60.98 0 0 0 9.349 32.535l1.455 2.312-6.179 22.558zm-40.811 23.544L24.16 123.88c-6.438-11.154-9.825-23.808-9.821-36.772.017-40.556 33.021-73.55 73.578-73.55 19.681.01 38.154 7.669 52.047 21.572s21.537 32.383 21.53 52.037c-.018 40.553-33.027 73.553-73.578 73.553h-.032c-12.313-.005-24.412-3.094-35.159-8.954zm0 0" filter="url(#reader-whatsapp-blur)"/>
                    <path fill="#fff" d="m12.966 161.238 10.439-38.114a73.42 73.42 0 0 1-9.821-36.772c.017-40.556 33.021-73.55 73.578-73.55 19.681.01 38.154 7.669 52.047 21.572s21.537 32.383 21.53 52.037c-.018 40.553-33.027 73.553-73.578 73.553h-.032c-12.313-.005-24.412-3.094-35.159-8.954z"/>
                    <path fill="url(#reader-whatsapp-gradient)" d="M87.184 25.227c-33.733 0-61.166 27.423-61.178 61.13a60.98 60.98 0 0 0 9.349 32.535l1.455 2.313-6.179 22.558 23.146-6.069 2.235 1.324c9.387 5.571 20.15 8.517 31.126 8.523h.023c33.707 0 61.14-27.426 61.153-61.135a60.75 60.75 0 0 0-17.895-43.251 60.75 60.75 0 0 0-43.235-17.928z"/>
                    <path fill="#fff" fill-rule="evenodd" d="M68.772 55.603c-1.378-3.061-2.828-3.123-4.137-3.176l-3.524-.043c-1.226 0-3.218.46-4.902 2.3s-6.435 6.287-6.435 15.332 6.588 17.785 7.506 19.013 12.718 20.381 31.405 27.75c15.529 6.124 18.689 4.906 22.061 4.6s10.877-4.447 12.408-8.74 1.532-7.971 1.073-8.74-1.685-1.226-3.525-2.146-10.877-5.367-12.562-5.981-2.91-.919-4.137.921-4.746 5.979-5.819 7.206-2.144 1.381-3.984.462-7.76-2.861-14.784-9.124c-5.465-4.873-9.154-10.891-10.228-12.73s-.114-2.835.808-3.751c.825-.824 1.838-2.147 2.759-3.22s1.224-1.84 1.836-3.065.307-2.301-.153-3.22-4.032-10.011-5.666-13.647"/>
                  </svg>
                  <span data-i18n="shareBar.whatsapp">WhatsApp</span>
                </a>
                <a class="share-bar__button" id="reader-share-email" href="#" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 6.75C3 5.231 4.231 4 5.75 4h12.5C19.769 4 21 5.231 21 6.75v10.5C21 18.769 19.769 20 18.25 20H5.75C4.231 20 3 18.769 3 17.25V6.75Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M3.75 7.5L12 13.125L20.25 7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span data-i18n="shareBar.email">Email</span>
                </a>
                <button class="share-bar__button" id="reader-share-copy" type="button">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M8 8H16V20H8V8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M6 6H17.5C18.328 6 19 6.672 19 7.5V17.5C19 18.328 18.328 19 17.5 19H16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M8 8L12 12L16 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span data-i18n="shareBar.copyLink">Copy link</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>



  <script define:vars={{ translations }}>
    // i18n
    function applyI18n(lang) {
      const tr = translations[lang] || translations['en'];
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const keys = el.getAttribute('data-i18n').split('.');
        let val = tr; for (const k of keys) val = val?.[k];
        if (!val || typeof val !== 'string') return;
        if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
          el.placeholder = val;
          return;
        }
        el.textContent = val;
      });
      const filtersToggle = document.getElementById('filters-toggle');
      if (filtersToggle) filtersToggle.setAttribute('aria-label', tr.library.filtersToggle || 'Toggle filters');
      const clearButton = document.getElementById('search-clear');
      if (clearButton) clearButton.setAttribute('aria-label', tr.common.clear || 'Clear search');
      const readerClose = document.getElementById('reader-close');
      if (readerClose) readerClose.setAttribute('aria-label', tr.library.readerClose || 'Close reader');
    }
    function setLibraryLangFilter(lang) {
      document.querySelectorAll('#lang-filters .filter-chip').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.lang === lang);
      });
      state.lang = lang;
    }

    window.addEventListener('lang-change', () => {
      const lang = window.__settings?.lang || 'en';
      applyI18n(lang);
      setLibraryLangFilter(lang);
      applyFilters();
    });

    // ── STATE ────────────────────────────────────────────────────────────────────
    const state = { query: '', cat: 'all', lang: window.__settings?.lang || 'en', sort: 'title', featured: false };

    const grid       = document.getElementById('book-grid');
    const cards      = Array.from(grid.querySelectorAll('.book-card'));
    const emptyState = document.getElementById('empty-state');
    const countBar   = document.getElementById('results-count-bar');
    const searchInput= document.getElementById('search-input');
    const clearBtn   = document.getElementById('search-clear');

    applyI18n(window.__settings?.lang || 'en');
    setLibraryLangFilter(window.__settings?.lang || 'en');

    function applyFilters() {
      const q = state.query.trim().toLowerCase();

      // Sort
      const sorted = [...cards].sort((a, b) => {
        if (state.sort === 'author')   return (a.dataset.author || '').localeCompare(b.dataset.author || '');
        if (state.sort === 'category') return (a.dataset.cat || '').localeCompare(b.dataset.cat || '');
        return (a.dataset.title || '').localeCompare(b.dataset.title || '');
      });
      sorted.forEach(c => grid.appendChild(c));

      let visible = 0;
      cards.forEach(card => {
        const matchCat  = state.cat  === 'all' || card.dataset.cat  === state.cat;
        const matchLang = card.dataset.lang === state.lang;
        const matchFeat = !state.featured || card.dataset.featured === 'true';
        const matchQ    = !q
          || (card.dataset.title  || '').includes(q)
          || (card.dataset.author || '').includes(q)
          || (card.dataset.desc   || '').includes(q);

        const show = matchCat && matchLang && matchFeat && matchQ;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      emptyState.style.display = visible === 0 ? 'block' : 'none';
      const lang = window.__settings?.lang || 'en';
      const tr = translations[lang] || translations['en'];
      const label = lang === 'ar'
        ? `${visible} ${tr.library.booksSingular}`
        : `${visible} ${visible === 1 ? tr.library.booksSingular : tr.library.booksPlural}`;
      countBar.textContent = label;
      const heroCount = document.getElementById('results-count');
      if (heroCount) heroCount.textContent = label;
    }

    applyFilters();

    // ── SEARCH ───────────────────────────────────────────────────────────────────
    searchInput.addEventListener('input', () => {
      state.query = searchInput.value;
      clearBtn?.classList.toggle('visible', state.query.length > 0);
      applyFilters();
    });
    clearBtn?.addEventListener('click', () => {
      searchInput.value = ''; state.query = '';
      clearBtn.classList.remove('visible');
      searchInput.focus(); applyFilters();
    });

    // ── CATEGORY ─────────────────────────────────────────────────────────────────
    document.querySelectorAll('#cat-filters .filter-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#cat-filters .filter-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active'); state.cat = btn.dataset.cat; applyFilters();
      });
    });

    // ── LANGUAGE ─────────────────────────────────────────────────────────────────
    document.querySelectorAll('#lang-filters .filter-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#lang-filters .filter-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active'); state.lang = btn.dataset.lang; applyFilters();
      });
    });

    // ── SORT ─────────────────────────────────────────────────────────────────────
    document.querySelectorAll('#sort-filters .filter-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#sort-filters .filter-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active'); state.sort = btn.dataset.sort; applyFilters();
      });
    });

    // ── FEATURED ─────────────────────────────────────────────────────────────────
    document.getElementById('featured-filter')?.addEventListener('click', function() {
      state.featured = !state.featured;
      this.classList.toggle('active', state.featured);
      applyFilters();
    });

    // ── ADVANCED TOGGLE ───────────────────────────────────────────────────────────
    // ── FILTERS TOGGLE (all screens) ──────────────────────────────────────────
    const filtersToggle = document.getElementById('filters-toggle');
    const filtersPanel  = document.getElementById('filters-panel');
    filtersToggle.addEventListener('click', () => {
      filtersPanel.classList.toggle('open');
      filtersToggle.classList.toggle('open');
    });

    // ── READER (full PDF.js viewer)
    const overlay      = document.getElementById('reader-overlay');
    const iframe       = document.getElementById('reader-iframe');
    const loading      = document.getElementById('reader-loading');
    const readerTitle  = document.getElementById('reader-title');
    const readerAuthor = document.getElementById('reader-author');
    const archiveLink  = document.getElementById('reader-archive-link');
    const downloadLink = document.getElementById('reader-download-link');
    const shareToggle  = document.getElementById('reader-share-toggle');
    const sharePopup   = document.getElementById('reader-share-popup');
    const shareTelegram = document.getElementById('reader-share-telegram');
    const shareWhatsapp = document.getElementById('reader-share-whatsapp');
    const shareEmail = document.getElementById('reader-share-email');
    const shareCopy = document.getElementById('reader-share-copy');
    const readerError = document.getElementById('reader-error');
    const readerErrorText = document.getElementById('reader-error-text');
    const catTag       = document.getElementById('reader-cat-tag');
    const langTag      = document.getElementById('reader-lang-tag');
    const sizeTag      = document.getElementById('reader-size-tag');
    const closeBtn     = document.getElementById('reader-close');

    async function openReader(card) {
      const pdfUrl     = card.dataset.pdf;
      const archiveUrl = card.dataset.archive || '#';
      const lang       = window.__settings?.lang || 'en';
      const title      = card.dataset[`displayTitle${lang === 'ar' ? 'Ar' : 'En'}`] || card.dataset.title;
      const author     = card.dataset[`displayAuthor${lang === 'ar' ? 'Ar' : 'En'}`] || card.dataset.author;
      const bookId     = card.dataset.id;
      const shareUrl   = `${window.location.origin}${window.location.pathname}?book=${encodeURIComponent(bookId)}`;
      const tr         = translations[lang] || translations['en'];
      const authorLabel = tr.library.readerAuthorLabel || (lang === 'ar' ? 'المؤلف:' : 'Author:');

      readerTitle.textContent  = title;
      readerAuthor.textContent = `${authorLabel} ${author}`;
      catTag.textContent       = tr.library.category?.[card.dataset.cat] || card.dataset.cat;
      langTag.textContent      = tr.library.lang?.[card.dataset.lang] || card.dataset.lang;
      sizeTag.textContent      = card.querySelector('.book-card__size')?.textContent || '';

      archiveLink.href  = archiveUrl || '#';
      archiveLink.style.display = archiveUrl && archiveUrl !== '#' ? '' : 'none';

      downloadLink.href = pdfUrl || '#';
      downloadLink.style.display = pdfUrl ? '' : 'none';
      if (shareTelegram) shareTelegram.href = 'https://t.me/share/url?url=' + encodeURIComponent(shareUrl) + '&text=' + encodeURIComponent(title);
      if (shareWhatsapp) shareWhatsapp.href = 'https://wa.me/?text=' + encodeURIComponent(title + ' ' + shareUrl);
      if (shareEmail) shareEmail.href = 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(author + '\n\n' + shareUrl);
      if (shareCopy) {
        shareCopy.onclick = function() {
          if (!navigator.clipboard) return;
          navigator.clipboard.writeText(shareUrl).then(function() {
            const original = shareCopy.textContent;
            shareCopy.textContent = 'Copied';
            setTimeout(function() { shareCopy.textContent = original; }, 1500);
          });
        };
      }

      // Full PDF.js viewer
      loading.style.display = 'flex';
      if (readerError) {
        readerError.hidden = true;
        readerErrorText.textContent = '';
      }
      sharePopup?.classList.remove('open');
      sharePopup?.setAttribute('aria-hidden', 'true');

      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      iframe.removeAttribute('src');
      iframe.style.display = 'none';

      if (!pdfUrl) {
        loading.style.display = 'none';
        if (readerError) {
          readerError.hidden = false;
          readerErrorText.textContent = tr.library.readerPreviewError || 'No PDF found.';
        }
        return;
      }

      try {
        const parsedPdfUrl = new URL(pdfUrl, window.location.origin);
        const isSameOriginPdf = parsedPdfUrl.origin === window.location.origin;
        const effectivePdfUrl = isSameOriginPdf
          ? parsedPdfUrl.toString()
          : new URL('/api/pdf-proxy', window.location.origin).toString() + '?url=' + encodeURIComponent(parsedPdfUrl.toString());

        const viewerUrl = '/pdfjs-5.7.284-dist/web/viewer.html?file=' + encodeURIComponent(effectivePdfUrl);
        const onLoad = () => {
          loading.style.display = 'none';
          iframe.removeEventListener('load', onLoad);
        };

        iframe.addEventListener('load', onLoad, { once: true });
        iframe.src = viewerUrl;
        iframe.style.display = 'block';
      } catch (err) {
        console.error('[PDF Viewer]', err);
        loading.style.display = 'none';
        if (readerError) {
          readerError.hidden = false;
          readerErrorText.textContent = tr.library.readerPreviewError || 'Unable to preview this PDF. Please download it instead.';
        }
      }
    }

    function openBookFromQuery() {
      const params = new URLSearchParams(window.location.search);
      const requestedId = params.get('book');
      if (!requestedId) return;

      const card = cards.find(c => c.dataset.id === requestedId);
      if (!card) return;

      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      openReader(card);
    }


    function closeReader() {
      overlay.classList.remove('open');
      document.body.style.overflow = '';
      if (sharePopup) {
        sharePopup.classList.remove('open', 'top');
        sharePopup.setAttribute('aria-hidden', 'true');
      }
      iframe.removeAttribute('src');
      iframe.style.display = 'none';
    }

    closeBtn.addEventListener('click', closeReader);
    overlay.addEventListener('click', e => { if (e.target === overlay) closeReader(); });
    if (shareToggle) {
      shareToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = sharePopup?.classList.toggle('open');
        shareToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

        if (sharePopup && shareToggle && isOpen) {
          const rect = shareToggle.getBoundingClientRect();
          const popupHeight = sharePopup.scrollHeight;
          const hasSpaceBelow = rect.bottom + popupHeight + 16 <= window.innerHeight;
          const hasSpaceAbove = rect.top - popupHeight - 16 >= 0;
          sharePopup.classList.toggle('top', !hasSpaceBelow && hasSpaceAbove);
        }

        sharePopup?.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      });
    }
    document.addEventListener('click', e => {
      if (!(e.target instanceof Node)) return;
      if (sharePopup && !sharePopup.contains(e.target) && e.target !== shareToggle) {
        sharePopup.classList.remove('open');
        sharePopup.setAttribute('aria-hidden', 'true');
      }
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeReader(); });

    // Card clicks
    cards.forEach(card => {
      card.setAttribute('tabindex', '0');
      card.setAttribute('role', 'button');
      card.addEventListener('click', () => openReader(card));
      card.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') openReader(card); });
    });

    openBookFromQuery();
  </script>
</Base>
