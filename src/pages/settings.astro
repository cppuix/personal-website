---
import Base from '../layouts/Base.astro';
import Nav  from '../components/Nav.astro';
import { translations } from '../i18n/translations.js';
---
<Base title="Settings" description="Appearance and language settings.">
  <Nav />

  <main style="padding: 4rem 0 6rem;">
    <div class="container--narrow">

      <p class="section__label" data-i18n="settings.preferences">Preferences</p>
      <h1 style="font-size: 2.5rem; margin-bottom: 3rem;" data-i18n="settings.title">Settings</h1>

      <div class="settings-grid">

        <!-- THEME -->
        <div class="settings-section">
          <h3 data-i18n="settings.theme">Theme</h3>
          <div class="settings-options">
            <button class="settings-option-card" data-setting="theme" data-value="default">
              <span style="width:48px;height:28px;border-radius:4px;display:block;background:linear-gradient(135deg,#F5F0E8 50%,#1A1410 50%);border:1px solid #D4C4A8;"></span>
              <span data-i18n="settings.themeDefault">Parchment</span>
            </button>
            <button class="settings-option-card" data-setting="theme" data-value="ink">
              <span style="width:48px;height:28px;border-radius:4px;display:block;background:linear-gradient(135deg,#FAFAFA 50%,#0A0A0A 50%);border:1px solid #D0D0D0;"></span>
              <span data-i18n="settings.themeInk">Ink</span>
            </button>
            <button class="settings-option-card" data-setting="theme" data-value="emerald">
              <span style="width:48px;height:28px;border-radius:4px;display:block;background:linear-gradient(135deg,#F0F7F4 50%,#0A1410 50%);border:1px solid #AECEC0;"></span>
              <span data-i18n="settings.themeEmerald">Emerald</span>
            </button>
          </div>
        </div>

        <!-- MODE -->
        <div class="settings-section">
          <h3 data-i18n="settings.mode">Mode</h3>
          <div class="settings-options">
            <button class="settings-option" data-setting="mode" data-value="light" data-i18n="settings.light">Light</button>
            <button class="settings-option" data-setting="mode" data-value="dark"  data-i18n="settings.dark">Dark</button>
          </div>
        </div>

        <!-- LANGUAGE -->
        <div class="settings-section">
          <h3 data-i18n="settings.language">Language</h3>
          <div class="settings-options">
            <button class="settings-option" data-setting="lang" data-value="en" data-i18n="settings.langEnglish">English</button>
            <button class="settings-option" data-setting="lang" data-value="ar" data-i18n="settings.langArabic">العربية</button>
          </div>
        </div>

        <!-- FONT SIZE -->
        <div class="settings-section">
          <h3 data-i18n="settings.fontSize">Font Size</h3>
          <div class="settings-options">
            <button class="settings-option" data-setting="fontsize" data-value="sm" data-i18n="settings.small">Small</button>
            <button class="settings-option" data-setting="fontsize" data-value="md" data-i18n="settings.medium">Medium</button>
            <button class="settings-option" data-setting="fontsize" data-value="lg" data-i18n="settings.large">Large</button>
          </div>
        </div>

        <!-- RESET -->
        <div class="settings-section" style="border-style: dashed;">
          <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
            <p style="color:var(--text-muted); font-size:var(--font-size-sm); margin:0;" data-i18n="settings.resetDesc">Restore all settings to their defaults.</p>
            <button id="reset-btn" class="settings-option" style="border-color:var(--accent); color:var(--accent);" data-i18n="settings.reset">Reset to defaults</button>
          </div>
          <p id="saved-toast" style="color:var(--accent);font-size:var(--font-size-sm);margin:0.75rem 0 0;opacity:0;transition:opacity 0.3s;" data-i18n="settings.saved">Saved</p>
        </div>

      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p data-i18n="footer.text">May Allah make it beneficial.</p>
    </div>
  </footer>

  <script define:vars={{ translations }}>
    function applyI18n(lang) {
      const tr = translations[lang] || translations['en'];
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const keys = el.getAttribute('data-i18n').split('.');
        let val = tr;
        for (const k of keys) val = val?.[k];
        if (val && typeof val === 'string') el.textContent = val;
      });
    }

    function syncActiveStates() {
      if (!window.__settings) return;
      const s = window.__settings;
      document.querySelectorAll('[data-setting]').forEach(btn => {
        const key = btn.getAttribute('data-setting');
        const val = btn.getAttribute('data-value');
        btn.classList.toggle('active', s[key] === val);
      });
    }

    function showSaved() {
      const toast = document.getElementById('saved-toast');
      if (!toast) return;
      toast.style.opacity = '1';
      setTimeout(() => { toast.style.opacity = '0'; }, 1800);
    }

    // Init
    applyI18n(window.__settings?.lang || 'en');
    syncActiveStates();

    // Setting buttons
    document.querySelectorAll('[data-setting]').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-setting');
        const val = btn.getAttribute('data-value');
        window.updateSetting(key, val);
        syncActiveStates();
        showSaved();
        if (key === 'lang') applyI18n(val);
      });
    });

    // Reset button
    document.getElementById('reset-btn')?.addEventListener('click', () => {
      window.resetSettings();
      syncActiveStates();
      applyI18n(window.__settings?.lang || 'en');
      showSaved();
    });

    // Lang change from nav toggle
    window.addEventListener('lang-change', () => {
      applyI18n(window.__settings?.lang || 'en');
      syncActiveStates();
    });

    window.addEventListener('settings-reset', () => syncActiveStates());
  </script>
</Base>
