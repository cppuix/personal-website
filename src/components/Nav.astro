---
import { translations } from '../i18n/translations.js';
---
<nav class="nav">
  <div class="nav__inner">
  <button class="nav__hamburger" id="hamburger" aria-label="Menu">
  <span></span>
  <span></span>
  <span></span>
</button>
    <a href="/" class="nav__logo" aria-label="Home">
      <span>عَبْدُ الرَّحْمَنِ بْنُ مِيهُوبَ القَدَّارِيُّ</span>
      <span class="en-name">Abdurraḥmān bnu Mīhūb al-Qaddārī</span>
    </a>

    <ul class="nav__links" id="nav-links">
      <li><a href="/" data-i18n="nav.home">Home</a></li>
      <li><a href="/library" data-i18n="nav.library">Library</a></li>
      <li><a href="/blog" data-i18n="nav.blog">Blog</a></li>
      <li><a href="/apps" data-i18n="nav.projects">Projects</a></li>
      <li><a href="/about" data-i18n="nav.about">About</a></li>
      <li><a href="/contact" data-i18n="nav.contact">Contact</a></li>
    </ul>

    <div class="nav__actions">
      <button class="btn-icon" id="lang-toggle" aria-label="Switch language">AR / EN</button>
      <button class="btn-icon" id="mode-toggle" aria-label="Toggle dark mode">◐</button>
      <a href="/settings" class="btn-icon" aria-label="Settings">⚙</a>
    </div>
  </div>
</nav>

<script define:vars={{ translations }}>
  function applyI18n(lang) {
    const tr = translations[lang] || translations['en'];
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const keys = el.getAttribute('data-i18n').split('.');
      let val = tr;
      for (const k of keys) val = val?.[k];
      if (val && typeof val === 'string') el.textContent = val;
    });
  }

  applyI18n(window.__settings?.lang || 'en');

  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const next = (window.__settings?.lang || 'en') === 'ar' ? 'en' : 'ar';
    window.updateSetting('lang', next);
    applyI18n(next);
  });

  document.getElementById('mode-toggle')?.addEventListener('click', () => {
    const next = (window.__settings?.mode || 'light') === 'light' ? 'dark' : 'light';
    window.updateSetting('mode', next);
  });

  window.addEventListener('lang-change', () => applyI18n(window.__settings?.lang || 'en'));
</script>
<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.querySelector('.nav__links');
  if (hamburger && navLinks) {
    hamburger.addEventListener('click', () => {
      navLinks.classList.toggle('open');
      hamburger.classList.toggle('open');
    });
  }
</script>