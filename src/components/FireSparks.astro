---
// Number of sparks (default 8)
const { count = 8 } = Astro.props;
---

<div class="fire-sparks" aria-hidden="true">
  {Array.from({ length: count }).map((_, i) => (
    <span class="spark" style={`--i:${i}; --total:${count}`}></span>
  ))}
</div>

<style>
  .fire-sparks {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .spark {
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--accent-soft, #B5622A);
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    opacity: 0;
    animation: spark-drift 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.7s);
    top: calc(100% * var(--i) / var(--total) + 10%);
    left: calc(90% * var(--i) / var(--total) + 5%);
  }

  @keyframes spark-drift {
    0% {
      opacity: 0;
      transform: translateY(0) rotate(0deg) scale(0.5);
    }
    20% {
      opacity: 0.7;
    }
    40% {
      opacity: 0.2;
      transform: translateY(-10px) rotate(30deg) scale(1.2);
    }
    100% {
      opacity: 0;
      transform: translateY(-80px) rotate(180deg) scale(0.2);
    }
  }
</style>