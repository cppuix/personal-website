---
import '../styles/global.css';
import '../styles/blog-content.css';
import Twinkles from '../components/Twinkles.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'عبد الرحمن بن ميهوب القدّاري',
  description = '',
  canonical = '/',
  image = '/og/default.svg',
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleTags = [] as string[],
} = Astro.props;

const siteUrl = (import.meta.env.SITE || 'https://alqaddari.vercel.app').replace(/\/+$/, '');
const canonicalPath = typeof canonical === 'string' ? canonical : '/';
const canonicalUrl = /^https?:\/\//.test(canonicalPath)
  ? canonicalPath
  : `${siteUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`;
const imageUrl = image && /^https?:\/\//.test(image) ? image : `${siteUrl}${image?.startsWith('/') ? image : `/${image}`}`;

const pageSchema = {
  '@type': ogType === 'article' ? 'Article' : 'WebPage',
  headline: title,
  description,
  url: canonicalUrl,
  image: imageUrl ? [imageUrl] : undefined,
  isPartOf: { '@id': `${siteUrl}/#website` },
  ...(ogType === 'article'
    ? {
        datePublished: articlePublishedTime,
        dateModified: articleModifiedTime || articlePublishedTime,
        author: articleAuthor
          ? { '@type': 'Person', name: articleAuthor }
          : { '@id': `${siteUrl}/#person` },
        keywords: articleTags.length ? articleTags.join(', ') : undefined,
      }
    : {}),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'عبد الرحمن بن ميهوب القدّاري',
      inLanguage: ['ar', 'en'],
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'عبد الرحمن بن ميهوب القدّاري',
      url: siteUrl,
    },
    pageSchema,
  ],
};
---
<!DOCTYPE html>
<html data-theme="default" data-mode="light" data-fontsize="md">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-2VM8Q8FKQ5"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-2VM8Q8FKQ5');
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  {imageUrl && <meta property="og:image" content={imageUrl} />}
  <meta name="theme-color" content="#F2EBD9" />
  <meta name="robots" content="index, follow" />
  {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
  {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
  {articleTags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  <script type="application/ld+json">
    {JSON.stringify(jsonLd)}
  </script>

  <!-- Settings engine: runs FIRST, before anything renders, to avoid flicker -->
  <script is:inline>
    (function() {
      var html = document.documentElement;

      var DEFAULTS = { theme: 'default', mode: 'light', lang: null, fontsize: 'md' };

      function detectLang() {
        var langs = navigator.languages || [navigator.language || 'en'];
        for (var i = 0; i < langs.length; i++) {
          if (langs[i].startsWith('ar')) return 'ar';
        }
        return 'en';
      }

      function applySettings(s) {
        html.setAttribute('data-theme',    s.theme);
        html.setAttribute('data-mode',     s.mode);
        html.setAttribute('data-fontsize', s.fontsize);
        html.setAttribute('lang', s.lang === 'ar' ? 'ar' : 'en');
        html.setAttribute('dir',  s.lang === 'ar' ? 'rtl' : 'ltr');
      }

      function loadSettings() {
        try {
          var stored = JSON.parse(localStorage.getItem('site-settings') || '{}');
          return {
            theme:    stored.theme    || DEFAULTS.theme,
            mode:     stored.mode     || DEFAULTS.mode,
            lang:     stored.lang     || detectLang(),
            fontsize: stored.fontsize || DEFAULTS.fontsize,
          };
        } catch(e) {
          return { theme: DEFAULTS.theme, mode: DEFAULTS.mode, lang: detectLang(), fontsize: DEFAULTS.fontsize };
        }
      }

      function saveSettings(s) {
        try { localStorage.setItem('site-settings', JSON.stringify(s)); } catch(e) {}
      }

      window.__settings = loadSettings();
      applySettings(window.__settings);

      window.__DEFAULTS = DEFAULTS;

      window.updateSetting = function(key, value) {
        window.__settings[key] = value;
        saveSettings(window.__settings);
        applySettings(window.__settings);
        if (key === 'lang') window.dispatchEvent(new Event('lang-change'));
      };

      window.resetSettings = function() {
        var fresh = { theme: DEFAULTS.theme, mode: DEFAULTS.mode, lang: detectLang(), fontsize: DEFAULTS.fontsize };
        window.__settings = fresh;
        saveSettings(fresh);
        applySettings(fresh);
        window.dispatchEvent(new Event('lang-change'));
        window.dispatchEvent(new Event('settings-reset'));
      };
    })();
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <Twinkles />
  <div class="page-main">
    <slot />
  </div>
  <Footer />
</body>
</html>