{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "titleAr": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "descriptionAr": {
      "type": "string"
    },
    "href": {
      "type": "string"
    },
    "coverImage": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "education",
        "library",
        "publishing",
        "community",
        "tool",
        "other"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "PWA",
        "Website"
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "type": "number"
    },
    "note": {
      "type": "string"
    },
    "noteAr": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "href",
    "type"
  ]
}