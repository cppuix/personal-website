{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "aqeedah",
        "fiqh",
        "hadith",
        "tafsir",
        "seerah",
        "manhaj",
        "fitan",
        "translations",
        "other"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "pdfUrl": {
      "type": "string",
      "format": "uri"
    },
    "archiveUrl": {
      "type": "string",
      "format": "uri"
    },
    "coverImage": {
      "type": "string",
      "format": "uri"
    },
    "size": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "author",
    "description",
    "category",
    "language",
    "pdfUrl",
    "archiveUrl"
  ]
}